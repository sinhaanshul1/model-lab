# Local PostgreSQL database used by the ModelLab API.
MODELLAB_DATABASE_URL=postgresql+psycopg://localhost/modellab_dev

# Dedicated database used only by the persistence test suite.
MODELLAB_TEST_DATABASE_URL=postgresql+psycopg://localhost/modellab_test

# Required only with docker-compose.docker-provider.yaml. Pin this tag so
# repeated benchmarks use the same serving engine implementation.
MODELLAB_VLLM_IMAGE=vllm/vllm-openai:v0.21.0
